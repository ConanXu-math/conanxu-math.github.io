---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
{% assign prefix = '' %}{% if site.active_lang != site.default_lang %}{% assign prefix = '/' | append: site.active_lang %}{% endif %}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
<title>Conan Xu · {% if site.active_lang == 'en' %}Blog{% else %}博客{% endif %}</title>
<link>{{ site.url }}{{ prefix }}/</link>
<description>{{ site.description | xml_escape }}</description>
<language>{{ site.active_lang }}</language>
<atom:link href="{{ site.url }}{{ prefix }}/feed.xml" rel="self" type="application/rss+xml"/>
{% for post in site.posts limit: 20 %}<item><title>{{ post.title | xml_escape }}</title><link>{{ site.url }}{{ prefix }}{{ post.url }}</link><guid>{{ site.url }}{{ prefix }}{{ post.url }}</guid><pubDate>{{ post.date | date_to_rfc822 }}</pubDate><description>{{ post.content | xml_escape }}</description></item>{% endfor %}
</channel></rss>
